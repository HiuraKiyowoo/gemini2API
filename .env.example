# ============================================================================
# gemini2API — contoh konfigurasi environment
# Salin ke `.env` lalu isi nilainya. TIDAK ADA nilai rahasia di file ini.
#   cp .env.example .env
# ============================================================================

# ---- Server ---------------------------------------------------------------
PORT=7860
LOG_LEVEL=INFO
# Base directory for data/ and logs/ when running outside Docker.
# Kosongkan untuk default (folder repo). Docker mengeset /app.
BASE_DIR=

# ---- Admin / WebUI --------------------------------------------------------
# WAJIB diisi sebelum memakai WebUI atau API admin. Kosong = warning di log
# dan endpoint admin menolak permintaan.
ADMIN_KEY=

# ---- Upstream Google OAuth (Code Assist) ----------------------------------
# Client ID/secret OAuth gemini-cli. Secret TIDAK di-commit.
CODE_ASSIST_CLIENT_ID=
CODE_ASSIST_CLIENT_SECRET=
# Opsional — override endpoint/token URL/project (biasanya tidak perlu).
# CODE_ASSIST_ENDPOINT=https://cloudcode-pa.googleapis.com/v1internal
# CODE_ASSIST_TOKEN_URL=https://oauth2.googleapis.com/token
# CODE_ASSIST_PROJECT=
# Lokasi file refresh-token OAuth (gitignored).
# CODE_ASSIST_OAUTH_FILE=data/google_oauth.json

# ---- Image generation (Imagen) --------------------------------------------
# Image gen HANYA jalan dengan Google AI Studio API key. Kredensial OAuth
# Code Assist ditolak (HTTP 403 ACCESS_TOKEN_SCOPE_INSUFFICIENT). Tanpa key
# ini, request image GAGAL LOUD (HTTP 503/500) — itu perilaku yang benar,
# bukan output palsu.
IMAGEN_API_KEY=
# Alias yang juga diterima: GOOGLE_IMAGEN_API_KEY, GEMINI_IMAGEN_API_KEY
# IMAGEN_MODEL=imagen-4.0-generate-001
# IMAGE_OUTPUT_DIR=data/generated/images

# ---- Downstream API keys (runtime-only, opsional) -------------------------
# Key ini diterima tapi tidak ditulis ke data/api_keys.json.
# GEMINI_API_KEY=
# GEMINI_API_KEYS=sk-key-1,sk-key-2
# GEMINI_API_KEY_1=

# ---- Keepalive (opsional) -------------------------------------------------
# KEEPALIVE_URL=https://your-domain.example/keepalive
# KEEPALIVE_INTERVAL=60

# ---- Path override file data (opsional, jarang dipakai) -------------------
# DATA_DIR=
# LOGS_DIR=
# CONFIG_FILE=
# ACCOUNTS_FILE=
# API_KEYS_FILE=
# USERS_FILE=

# ---- Streaming / retry / rate-limit tuning (opsional) ---------------------
WORKERS=1
BROWSER_POOL_SIZE=1
BROWSER_STREAM_TIMEOUT_SECONDS=1800
MAX_INFLIGHT_PER_ACCOUNT=2
UPSTREAM_STREAM_HEADER_TIMEOUT_SECONDS=120
UPSTREAM_STREAM_FIRST_EVENT_TIMEOUT_SECONDS=180
UPSTREAM_STREAM_IDLE_TIMEOUT_SECONDS=180
MAX_RETRIES=3
TOOL_RECOVERY_MAX_ATTEMPTS=4
ACCOUNT_MIN_INTERVAL_MS=0
REQUEST_JITTER_MIN_MS=0
REQUEST_JITTER_MAX_MS=0
RATE_LIMIT_BASE_COOLDOWN=600
RATE_LIMIT_MAX_COOLDOWN=3600
ACCOUNT_READY_SET_THRESHOLD=128
CHAT_DELETE_RETRY_ATTEMPTS=3
CHAT_DELETE_RETRY_DELAY_SECONDS=0.5
CHAT_ID_PREWARM_TARGET_PER_ACCOUNT=5
CHAT_ID_PREWARM_TTL_SECONDS=120
CHAT_ID_PREWARM_MAX_CONCURRENCY=16
TRACE_RESPONSE_FINGERPRINTS=0
TRACE_RESPONSE_TAIL_CHARS=160

# ---- Context/attachment pipeline (opsional) -------------------------------
CONTEXT_INLINE_MAX_CHARS=4000
CONTEXT_FORCE_FILE_MAX_CHARS=10000
CONTEXT_ATTACHMENT_TTL_SECONDS=1800
CONTEXT_UPLOAD_PARSE_TIMEOUT_SECONDS=60
CONTEXT_ALLOWED_GENERATED_EXTS=txt,md,json,log
CONTEXT_ALLOWED_USER_EXTS=txt,md,json,log,xml,yaml,yml,csv,html,css,py,js,ts,java,c,cpp,cs,php,go,rb,sh,zsh,ps1,bat,cmd,pdf,doc,docx,ppt,pptx,xls,xlsx,png,jpg,jpeg,webp,gif,tiff,bmp,svg
